# Get a key at https://agent.tinyfish.ai (API keys). Never commit server/.env or paste it anywhere.
TINYFISH_API_KEY=
PORT=8787
# Optional: if you deploy the server publicly, set a token and paste the same one in the extension Settings.
APP_TOKEN=

# Credit-safety mode: replay | record | live (default: replay)
TF_MODE=replay

# Daily hard caps per UTC day (persisted in server/.tfcache/usage.json)
MAX_FETCH_URLS_PER_DAY=150
MAX_SEARCHES_PER_DAY=40
MAX_AGENT_CALLS_PER_DAY=3
MAX_RESEARCH_RUNS_PER_DAY=0

# Explicit opt-in gates for credit-burning endpoints (1 to enable, 0 to block)
ALLOW_AGENT=0
ALLOW_RESEARCH=0
